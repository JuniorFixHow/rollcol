# Supabase project settings > API Keys. Use the publishable key (the legacy anon key also works).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Public address of this site, used in invite and password-reset emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
